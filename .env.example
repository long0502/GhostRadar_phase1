# ─── Required ───
DATABASE_URL=postgresql://user:password@host:5432/ghostradar
GEMINI_API_KEY=your-gemini-api-key

# ─── API Configuration ───
PORT=8088
GEMINI_MODEL=gemini-2.5-flash
NODE_ENV=production

# ─── Optional: Cache & Rate Limits ───
CACHE_TTL_SECONDS=86400
SCAN_RATE_LIMIT_MAX=30
EXPAND_RATE_LIMIT_MAX=15
RATE_LIMIT_WINDOW_MS=60000

# ─── Admin Dashboard ───
JWT_SECRET=change-this-to-a-strong-random-secret
ADMIN_PORT=4000

# ─── Web UI ───
NEXT_PUBLIC_API_BASE_URL=https://your-api-domain.railway.app
