# ─── Required ───
DATABASE_URL=postgresql://user:password@host:5432/ghostradar
AI_GATEWAY_URL=https://aiapifull.daquynangluongxanh.com
AI_GATEWAY_API_KEY=replace-with-your-runtime-api-key

# ─── API Configuration ───
PORT=8088
GEMINI_MODEL=gemini-2.5-flash
NODE_ENV=production

# ─── AI Gateway Config ───
AI_POLL_TIMEOUT_MS=180000
AI_POLL_INTERVAL_MS=3000
AI_GATEWAY_PROVIDER=gemini
AI_GATEWAY_INCLUDE_TIMEOUT=true
TURBO_SCAN_RADIUS_KM=10
SCAN_REQUESTED_QUANTITY_NORMAL=23-42
SCAN_REQUESTED_QUANTITY_TURBO=30-63
SCAN_MAX_OUTPUT_TOKENS=32768
SCAN_THINKING_BUDGET=512

# ─── Optional: Cache & Rate Limits ───
CACHE_TTL_SECONDS=86400
SCAN_RATE_LIMIT_MAX=30
EXPAND_RATE_LIMIT_MAX=15
RATE_LIMIT_WINDOW_MS=60000

# ─── Admin Dashboard ───
JWT_SECRET=change-this-to-a-strong-random-secret
ADMIN_PORT=4000

# ─── Web UI ───
NEXT_PUBLIC_API_BASE_URL=https://your-api-domain.railway.app
