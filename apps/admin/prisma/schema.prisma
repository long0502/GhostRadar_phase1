generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Admin-only table ───
model admin_users {
  id            String    @id @default(uuid())
  email         String    @unique
  password_hash String
  role          String    @default("admin")
  created_at    DateTime  @default(now())
  last_login    DateTime?
}

// ─── Read-only references to existing tables ───
model usage_logs {
  id              String   @id @default(uuid())
  timestamp       DateTime @default(now())
  action          String
  lat             Float?
  lon             Float?
  radius_km       Float?
  lang            String?
  grid_id         String?
  event_id        String?
  user_id         String?
  ip              String?
  cache_hit       Boolean  @default(false)
  ai_called       Boolean  @default(false)
  events_returned Int      @default(0)
  response_ms     Int      @default(0)
  error           String?

  @@index([timestamp])
  @@index([action])
  @@index([grid_id])
  @@index([ip])
}

model ai_call_logs {
  id              String   @id @default(uuid())
  timestamp       DateTime @default(now())
  endpoint        String
  model           String
  tokens_input    Int      @default(0)
  tokens_output   Int      @default(0)
  estimated_cost  Float    @default(0)
  event_id        String?
  latency_ms      Int      @default(0)
  success         Boolean  @default(true)
  error_message   String?

  @@index([timestamp])
  @@index([endpoint])
  @@index([model])
}

model events {
  id          String   @id @default(uuid())
  grid_id     String
  event_type  String
  event_data  Json
  has_detail  Boolean  @default(false)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  event_details event_details[]
}

model event_details {
  id           String   @id @default(uuid())
  event_id     String
  level        Int      @default(1)
  lang         String   @default("en")
  story_text   String
  witness      String
  analysis     String
  generated_at DateTime @default(now())
  detail       Json
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  event        events   @relation(fields: [event_id], references: [id])

  @@index([event_id, lang])
}

model grid_cache {
  id         String   @id @default(uuid())
  grid_id    String   @unique
  data       Json
  expires_at DateTime
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

// ─── API pipeline tables (must keep in sync) ───
model jobs {
  id         String   @id @default(uuid())
  type       String
  status     String
  payload    Json
  result     Json?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model raw_signal {
  id              String    @id @default(uuid())
  source          String
  fetch_key       String
  raw_payload     Json
  fetched_at      DateTime  @default(now())
  normalized_at   DateTime?
  normalize_error String?

  @@index([fetch_key])
  @@index([fetched_at])
}

model normalized_signal {
  id           String   @id @default(uuid())
  grid_id      String
  lat          Float
  lon          Float
  title        String
  summary      String
  event_type   String
  event_source String
  severity     Int?
  confidence   Float?
  signal_hash  String   @unique
  event_time   DateTime @default(now())
  created_at   DateTime @default(now())

  @@index([grid_id])
  @@index([created_at])
  @@index([lat, lon, event_time], map: "idx_geo_time")
}

model ingestion_run {
  id               String    @id @default(uuid())
  grid_id          String
  started_at       DateTime  @default(now())
  ended_at         DateTime?
  status           String
  raw_count        Int       @default(0)
  normalized_count Int       @default(0)
  deduped_count    Int       @default(0)
  error_message    String?

  @@index([grid_id])
  @@index([started_at])
}

model ai_quota_policy {
  scope       String   @id
  daily_limit Int
  updated_at  DateTime @default(now())
}

model ai_usage_daily {
  scope        String
  scope_key    String
  usage_date   DateTime @db.Date
  ai_calls     Int      @default(0)
  tokens       Int      @default(0)
  scan_calls   Int      @default(0)
  expand_calls Int      @default(0)
  updated_at   DateTime @default(now())

  @@id([scope, scope_key, usage_date])
}
